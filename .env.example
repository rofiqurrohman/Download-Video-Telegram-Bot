# Telegram Bot
# Token dari @BotFather
BOT_TOKEN=
# Telegram ID admin, pisahkan koma: 123456789,987654321
ADMIN_IDS=

# Telegram Client (GramJS) — untuk file > 50MB
# dari my.telegram.org
TELEGRAM_API_ID=
# dari my.telegram.org
TELEGRAM_API_HASH=
# StringSession hasil login GramJS (kosongkan untuk login pertama kali)
# ID channel penyimpanan, contoh: -1001234567890
STORAGE_CHANNEL_ID=

# yt-dlp API Service
# contoh: http://localhost:3001
YTDLP_API_BASE_URL=
# nilai header X-API-Key
YTDLP_API_KEY=

# MongoDB
# contoh: mongodb://localhost:27017/vtdlbot
MONGODB_URI=mongodb+srv://user:password@localhost/users_db

# URL Filter
VIDOY_URL_API=https://vdy.to
VIDOY_URLS=vidtronx.com,vide.la,vidoy.com,vidzp.com,vdy.to,cdn2.vid9.live
VIDARA_URLS=vidara.to,vidara.so
