# Telegram Bot
BOT_TOKEN=                      # Token dari @BotFather
ADMIN_IDS=                      # Telegram ID admin, pisahkan koma: 123456789,987654321

# Telegram Client (GramJS) — untuk file > 50MB
TELEGRAM_API_ID=                # dari my.telegram.org
TELEGRAM_API_HASH=              # dari my.telegram.org
TELEGRAM_SESSION=               # StringSession hasil login GramJS (kosongkan untuk login pertama kali)
STORAGE_CHANNEL_ID=             # ID channel penyimpanan, contoh: -1001234567890

# yt-dlp API Service
YTDLP_API_BASE_URL=             # contoh: http://localhost:3001
YTDLP_API_KEY=                  # nilai header X-API-Key

# MongoDB
MONGODB_URI=                    # contoh: mongodb://localhost:27017/vtdlbot
